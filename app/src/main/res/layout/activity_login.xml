<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Cartão Central de Login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevado"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Logomarca Oficial EnviJá -->
            <ImageView
                android:id="@+id/ivLogoEnvija"
                android:layout_width="170dp"
                android:layout_height="135dp"
                android:layout_marginBottom="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Logomarca Oficial EnviJá"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_envija" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EnviJá"
                android:textColor="@color/envija_roxo"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Logística Inteligente para Tecnologia"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="E-mail Corporativo"
                android:textColor="@color/envija_azul_marinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_campo"
                android:hint="operador@envija.com"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:textColor="@color/texto_principal"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Senha de Acesso"
                android:textColor="@color/envija_azul_marinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_campo"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:textColor="@color/texto_principal"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_botao_pilula_laranja"
                android:backgroundTint="@null"
                android:text="Acessar Painel Operacional"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>