<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:orientation="vertical">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/envija_roxo"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova Remessa Tech"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevado"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Dados da Carga e Nota Fiscal"
                android:textColor="@color/envija_azul_marinho"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDestinatario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Cliente / Destinatário"
                android:inputType="textPersonName"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Produto de Tecnologia (ex: Notebook, GPU)"
                android:inputType="text"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etNfeNum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Número da NF-e"
                android:inputType="number"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etNfeVal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Valor da NF-e (R$)"
                android:inputType="numberDecimal"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Peso e Dimensões (Cubagem 300 kg/m³)"
                android:textColor="@color/envija_azul_marinho"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Peso Real em kg (Máx. 30 kg)"
                android:inputType="numberDecimal"
                android:minHeight="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etComp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_campo"
                    android:hint="Comp (cm)"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etLarg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_campo"
                    android:hint="Larg (cm)"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etAlt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_campo"
                    android:hint="Alt (cm)"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbFragil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:buttonTint="@color/envija_roxo"
                android:minHeight="48dp"
                android:text="Equipamento Sensível / Carga Frágil"
                android:textColor="@color/texto_principal" />

            <!-- Botão 1: Calcular Frete -->
            <Button
                android:id="@+id/btnCalcularFrete"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_botao_pilula_roxo"
                android:backgroundTint="@null"
                android:text="Calcular Frete e Cubagem"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResumoCalculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@color/envija_roxo_claro"
                android:padding="14dp"
                android:text="Preencha os dados e toque em Calcular Frete."
                android:textColor="@color/envija_roxo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Botão 2: Registrar Remessa -->
            <Button
                android:id="@+id/btnSalvarRemessa"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_botao_pilula_laranja"
                android:backgroundTint="@null"
                android:text="Registrar Remessa"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>