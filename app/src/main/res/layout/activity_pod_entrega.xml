<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/envija_roxo"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proof of Delivery (POD Digital)"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevado"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Confirmação de Recebimento"
                android:textColor="@color/envija_azul_marinho"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCodigoPod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Código de Rastreio (ex: ENV123456BR)"
                android:inputType="textCapCharacters"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etRecebedorNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_campo"
                android:hint="Nome Completo do Recebedor"
                android:inputType="textPersonName"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etRecebedorDoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_campo"
                android:hint="RG ou CPF do Recebedor"
                android:inputType="text"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/cbLacreIntegro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:buttonTint="@color/envija_roxo"
                android:checked="true"
                android:minHeight="48dp"
                android:text="Embalagem e lacre anti-violação íntegros (Sem avarias)"
                android:textColor="@color/texto_principal" />

            <Button
                android:id="@+id/btnConfirmarPod"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_botao_pilula_laranja"
                android:backgroundTint="@null"
                android:text="Finalizar Entrega e Assinar POD"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>